{%- liquid
  assign current = product.selected_or_first_available_variant
  assign has_variants = true
  if product.has_only_default_variant
    assign has_variants = false
  endif
  assign rating = product.metafields.custom.rating.value
  assign rcount = product.metafields.custom.review_count.value
  assign warning = product.metafields.custom.warning_note
  assign amazon_url = product.metafields.custom.amazon_url.value
-%}

<style>
  #CP-{{ section.id }} {
    --cp-primary: {{ section.settings.primary }};
    --cp-accent: {{ section.settings.accent }};
    --cp-border: #e4e0d4;
    --cp-muted: #7a7a72;
    font-family: 'Archivo', sans-serif;
    color: #1a1a1a;
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 24px 48px;
  }
  #CP-{{ section.id }} * { box-sizing: border-box; }
  #CP-{{ section.id }} .cp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 48px;
    align-items: start;
  }

  /* ---------- badges ---------- */
  #CP-{{ section.id }} .cp-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  #CP-{{ section.id }} .cp-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 500; line-height: 1.2;
  }
  #CP-{{ section.id }} .cp-badge img { width: 14px; height: 14px; object-fit: contain; }

  /* ---------- title / rating ---------- */
  #CP-{{ section.id }} .cp-title {
    font-family: 'Cormorant SC', Georgia, serif;
    font-weight: 600; font-size: 28px; line-height: 1.25; letter-spacing: .02em; margin: 0 0 12px;
  }
  #CP-{{ section.id }} .cp-rating { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; }
  #CP-{{ section.id }} .cp-stars { position: relative; display: inline-block; color: #d9d6cb; font-size: 15px; letter-spacing: 1px; line-height: 1; }
  #CP-{{ section.id }} .cp-stars__fill { position: absolute; left: 0; top: 0; overflow: hidden; white-space: nowrap; color: #f5a623; }
  #CP-{{ section.id }} .cp-rating a { color: var(--cp-primary); text-decoration: underline; }
  #CP-{{ section.id }} .cp-trusted::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--cp-accent); margin-right: 6px; }
  #CP-{{ section.id }} .cp-vendor { font-size: 11px; margin: 10px 0 0; }
  #CP-{{ section.id }} .cp-vendor a { color: inherit; text-decoration: underline; }

  /* ---------- price ---------- */
  #CP-{{ section.id }} .cp-price { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 22px; }
  #CP-{{ section.id }} .cp-price__now { font-size: 26px; font-weight: 600; }
  #CP-{{ section.id }} .cp-price__was { font-size: 13px; color: var(--cp-muted); text-decoration: line-through; }
  #CP-{{ section.id }} .cp-price__off { background: var(--cp-accent); color: #fff; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 4px; }
  #CP-{{ section.id }} .cp-stock { color: #c0271b; font-size: 11px; font-weight: 600; }
  #CP-{{ section.id }} .cp-tax { font-size: 10px; color: var(--cp-muted); margin: 6px 0 0; }

  /* ---------- review cards ---------- */
  #CP-{{ section.id }} .cp-reviews { display: flex; gap: 10px; overflow-x: auto; margin: 18px 0 0; padding-bottom: 4px; scrollbar-width: none; }
  #CP-{{ section.id }} .cp-reviews::-webkit-scrollbar { display: none; }
  #CP-{{ section.id }} .cp-review {
    flex: 0 0 150px; border: 1px solid var(--cp-border); border-radius: 10px; background: #fff; padding: 10px 12px;
  }
  #CP-{{ section.id }} .cp-review__top { display: flex; justify-content: space-between; align-items: center; font-size: 11px; gap: 6px; }
  #CP-{{ section.id }} .cp-review__stars { color: #f5a623; font-size: 11px; letter-spacing: 1px; white-space: nowrap; }
  #CP-{{ section.id }} .cp-review p { margin: 8px 0 0; font-size: 11px; font-weight: 600; }

  /* ---------- select pack ---------- */
  #CP-{{ section.id }} .cp-label { font-size: 15px; margin: 24px 0 12px; }
  #CP-{{ section.id }} .cp-packs { display: flex; gap: 12px; flex-wrap: wrap; }
  #CP-{{ section.id }} .cp-pack-wrap { width: calc(33.333% - 8px); min-width: 100px; display: flex; flex-direction: column; }
  #CP-{{ section.id }} .cp-pack {
    position: relative; display: block; flex: 1; cursor: pointer;
    border: 1px solid var(--cp-border); border-radius: 8px; background: #fff; padding: 10px 10px 12px;
  }
  #CP-{{ section.id }} .cp-pack input { position: absolute; opacity: 0; pointer-events: none; }
  #CP-{{ section.id }} .cp-pack.is-selected { border: 1.5px solid var(--cp-primary); background: #f1faf7; }
  #CP-{{ section.id }} .cp-pack.is-soldout { opacity: .5; cursor: not-allowed; }
  #CP-{{ section.id }} .cp-pack__off { display: inline-block; background: #dff3ec; color: var(--cp-primary); font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-bottom: 8px; }
  #CP-{{ section.id }} .cp-pack__check { display: none; position: absolute; top: 8px; right: 8px; width: 16px; height: 16px; border-radius: 50%; background: var(--cp-primary); align-items: center; justify-content: center; }
  #CP-{{ section.id }} .cp-pack.is-selected .cp-pack__check { display: flex; }
  #CP-{{ section.id }} .cp-pack__title { display: block; font-size: 14px; font-weight: 500; }
  #CP-{{ section.id }} .cp-pack__sub { display: block; font-size: 11px; color: var(--cp-muted); margin: 2px 0 8px; min-height: 14px; }
  #CP-{{ section.id }} .cp-pack__price { font-size: 16px; font-weight: 700; }
  #CP-{{ section.id }} .cp-pack__was { font-size: 10px; color: var(--cp-muted); text-decoration: line-through; margin-left: 3px; }
  #CP-{{ section.id }} .cp-pack__per { display: block; font-size: 10px; color: var(--cp-muted); margin-top: 2px; }
  #CP-{{ section.id }} .cp-best { background: #fde3d6; color: var(--cp-accent); text-align: center; font-size: 10px; padding: 3px 0; border-radius: 0 0 6px 6px; margin: 0 4px; }

  /* ---------- warning ---------- */
  #CP-{{ section.id }} .cp-warning {
    margin-top: 22px; background: #fdf0c4; border: 1px solid #f2d97a; border-radius: 8px;
    padding: 12px 14px; font-size: 11px; line-height: 1.5;
  }

  /* ---------- buy row ---------- */
  #CP-{{ section.id }} .cp-buy { display: flex; gap: 12px; margin-top: 18px; align-items: stretch; }
  #CP-{{ section.id }} .cp-qty { display: inline-flex; align-items: center; border: 1px solid var(--cp-border); border-radius: 6px; background: #fff; height: 40px; }
  #CP-{{ section.id }} .cp-qty button { width: 32px; height: 100%; border: 0; background: none; font-size: 18px; cursor: pointer; color: #555; }
  #CP-{{ section.id }} .cp-qty input { width: 32px; text-align: center; border: 0; background: none; font-size: 13px; font-family: inherit; -moz-appearance: textfield; }
  #CP-{{ section.id }} .cp-qty input::-webkit-outer-spin-button,
  #CP-{{ section.id }} .cp-qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  #CP-{{ section.id }} .cp-btn {
    font-family: inherit; font-size: 14px; font-weight: 600; border-radius: 6px; cursor: pointer; height: 40px;
    border: 1.5px solid var(--cp-primary); text-align: center;
  }
  #CP-{{ section.id }} .cp-btn--add { flex: 1; background: #fff; color: var(--cp-primary); }
  #CP-{{ section.id }} .cp-btn--buy { background: var(--cp-primary); color: #fff; width: 100%; margin-top: 12px; height: 42px; }
  #CP-{{ section.id }} .cp-btn[disabled] { opacity: .5; cursor: not-allowed; }
  #CP-{{ section.id }} .cp-row2 { display: flex; gap: 12px; align-items: stretch; }
  #CP-{{ section.id }} .cp-row2 .cp-btn--buy { flex: 1; }
  #CP-{{ section.id }} .cp-amazon {
    display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 12px;
    border: 1px solid var(--cp-border); border-radius: 6px; background: #fff; padding: 0 16px; min-width: 100px;
    font-size: 9px; color: #444; text-decoration: none; height: 42px; line-height: 1.1;
  }
  #CP-{{ section.id }} .cp-amazon strong { font-size: 14px; color: #111; }

  /* ---------- features ---------- */
  #CP-{{ section.id }} .cp-features { display: flex; justify-content: space-between; gap: 12px; margin: 22px 0 14px; }
  #CP-{{ section.id }} .cp-feature { display: flex; align-items: center; gap: 8px; font-size: 11px; line-height: 1.35; flex: 1; }
  #CP-{{ section.id }} .cp-feature img { width: 30px; height: 30px; object-fit: contain; flex-shrink: 0; }

  /* ---------- accordions ---------- */
  #CP-{{ section.id }} .cp-acc { border-bottom: 1px solid var(--cp-border); }
  #CP-{{ section.id }} .cp-acc:first-of-type { border-top: 1px solid var(--cp-border); }
  #CP-{{ section.id }} .cp-acc summary {
    list-style: none; display: flex; justify-content: space-between; align-items: center;
    padding: 14px 0; font-size: 13px; cursor: pointer;
  }
  #CP-{{ section.id }} .cp-acc summary::-webkit-details-marker { display: none; }
  #CP-{{ section.id }} .cp-acc[open] summary svg { transform: rotate(180deg); }
  #CP-{{ section.id }} .cp-acc__body { padding: 0 0 16px; font-size: 13px; line-height: 1.6; color: #444; }

  /* ---------- gallery ---------- */
  #CP-{{ section.id }} .cp-gallery { position: relative; }
  #CP-{{ section.id }} .cp-main { position: relative; border-radius: 6px; overflow: hidden; background: #111; aspect-ratio: 1 / 1; }
  #CP-{{ section.id }} .cp-slide { display: none; width: 100%; height: 100%; }
  #CP-{{ section.id }} .cp-slide.is-active { display: block; }
  #CP-{{ section.id }} .cp-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #CP-{{ section.id }} .cp-heart {
    position: absolute; top: 0; right: 0; z-index: 2; width: 44px; height: 44px; background: #f1efe7;
    display: flex; align-items: center; justify-content: center; border-radius: 0 6px 0 10px; color: #222;
  }
  #CP-{{ section.id }} .cp-thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; }
  #CP-{{ section.id }} .cp-thumbs::-webkit-scrollbar { display: none; }
  #CP-{{ section.id }} .cp-thumb {
    flex: 0 0 72px; height: 72px; padding: 0; border: 2px solid transparent; border-radius: 4px; overflow: hidden; background: none; cursor: pointer;
  }
  #CP-{{ section.id }} .cp-thumb.is-active { border-color: var(--cp-primary); }
  #CP-{{ section.id }} .cp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---------- delivery ---------- */
  #CP-{{ section.id }} .cp-delivery { margin-top: 14px; }
  #CP-{{ section.id }} .cp-delivery h3 { font-size: 15px; font-weight: 500; margin: 0 0 8px; }
  #CP-{{ section.id }} .cp-delivery__row { display: flex; gap: 8px; }
  #CP-{{ section.id }} .cp-delivery input {
    flex: 1; height: 38px; border: 1px solid var(--cp-border); border-radius: 6px; padding: 0 12px;
    font-family: inherit; font-size: 12px; background: #fff;
  }
  #CP-{{ section.id }} .cp-delivery button {
    height: 38px; padding: 0 26px; border: 0; border-radius: 6px; background: var(--cp-primary); color: #fff;
    font-family: inherit; font-size: 13px; font-weight: 500; cursor: pointer;
  }
  #CP-{{ section.id }} .cp-delivery__msg { font-size: 12px; margin: 10px 0 0; min-height: 16px; }
  #CP-{{ section.id }} .cp-delivery__msg.is-error { color: #c0271b; }

  /* ---------- notice + offers ---------- */
  #CP-{{ section.id }} .cp-notice {
    margin-top: 16px; border-radius: 6px; padding: 18px 20px 18px 28px; position: relative;
    border-left: 8px solid var(--cp-accent);
  }
  #CP-{{ section.id }} .cp-notice h4 { margin: 0 0 6px; font-size: 15px; font-weight: 600; }
  #CP-{{ section.id }} .cp-notice p { margin: 0; font-size: 12px; line-height: 1.5; }
  #CP-{{ section.id }} .cp-offers { margin-top: 16px; background: #f4f2ea; border-radius: 6px; padding: 14px; }
  #CP-{{ section.id }} .cp-offers h3 { margin: 0 0 10px; font-size: 14px; font-weight: 500; }
  #CP-{{ section.id }} .cp-offers__list { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; }
  #CP-{{ section.id }} .cp-offers__list::-webkit-scrollbar { display: none; }
  #CP-{{ section.id }} .cp-offer {
    flex: 0 0 170px; background: #fff; border: 1px solid var(--cp-border); border-radius: 8px;
    padding: 12px; text-align: center; font-size: 11px;
  }
  #CP-{{ section.id }} .cp-offer b { display: block; font-size: 11px; font-weight: 600; }
  #CP-{{ section.id }} .cp-offer span { display: block; margin-top: 2px; }
  #CP-{{ section.id }} .cp-copy {
    margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; font-family: inherit; font-size: 10px; font-weight: 600;
    border: 1px dashed var(--cp-primary); color: var(--cp-primary); background: #fff; border-radius: 4px; padding: 4px 8px; cursor: pointer;
  }

  /* ---------- mobile ---------- */
  @media (max-width: 989px) {
    #CP-{{ section.id }} { padding: 0 16px 32px; }
    #CP-{{ section.id }} .cp-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    #CP-{{ section.id }} .cp-right { order: -1; }
    #CP-{{ section.id }} .cp-title { font-size: 22px; }
    #CP-{{ section.id }} .cp-features { flex-wrap: wrap; }
    #CP-{{ section.id }} .cp-feature { flex: 0 0 calc(50% - 6px); }
  }
</style>

<div id="CP-{{ section.id }}"
     data-sold-out="{{ section.settings.soldout_label | escape }}"
     data-add-label="{{ section.settings.add_label | escape }}"
     data-delivery-days="{{ section.settings.delivery_days }}"
     data-delivery-prefix="{{ section.settings.delivery_prefix | escape }}">
  <div class="cp-grid">

    {%- comment -%} ================= LEFT COLUMN ================= {%- endcomment -%}
    <div class="cp-left">

      {%- comment -%} Badges from product tags: add a tag like  badge:Boosts Immunity  {%- endcomment -%}
      {%- assign badge_total = 0 -%}
      {%- for tag in product.tags -%}
        {%- assign tag_prefix = tag | slice: 0, 6 | downcase -%}
        {%- if tag_prefix == 'badge:' -%}{%- assign badge_total = badge_total | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if badge_total > 0 -%}
        <div class="cp-badges">
          {%- for tag in product.tags -%}
            {%- assign tag_prefix = tag | slice: 0, 6 | downcase -%}
            {%- if tag_prefix == 'badge:' -%}
              {%- assign label = tag | slice: 6, 80 | strip -%}
              {%- assign label_l = label | downcase -%}
              {%- assign b_bg = section.settings.badge_bg -%}
              {%- assign b_color = section.settings.badge_text -%}
              {%- assign b_icon = nil -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'badge_style' -%}
                  {%- assign block_tag = block.settings.tag | downcase | strip -%}
                  {%- if block_tag == label_l -%}
                    {%- assign b_bg = block.settings.bg -%}
                    {%- assign b_color = block.settings.text_color -%}
                    {%- assign b_icon = block.settings.icon -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              <span class="cp-badge" style="background: {{ b_bg }}; color: {{ b_color }};">
                {%- if b_icon -%}
                  {{ b_icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
                {{ label }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <h1 class="cp-title">{{ product.title }}</h1>

      {%- if rating != blank -%}
        <div class="cp-rating">
          <span class="cp-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;
            <span class="cp-stars__fill" style="width: {{ rating | times: 20 }}%;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          </span>
          <a href="#reviews">{{ rating }}{% if rcount != blank %} from {{ rcount }} reviews{% endif %}</a>
          {%- if section.settings.trusted_text != blank -%}
            <span class="cp-trusted">{{ section.settings.trusted_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if product.vendor != blank -%}
        <p class="cp-vendor">Vendor: <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a></p>
      {%- endif -%}

      <div class="cp-price">
        <span class="cp-price__now">{{ current.price | money_without_trailing_zeros }}</span>
        <span class="cp-price__was"{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{{ current.compare_at_price | money_without_trailing_zeros }}</span>
        {%- assign cur_disc = 0 -%}
        {%- if current.compare_at_price > current.price -%}
          {%- assign cur_disc = current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price -%}
        {%- endif -%}
        <span class="cp-price__off"{% if cur_disc == 0 %} hidden{% endif %}>{{ cur_disc }}% off</span>
        {%- assign cur_stock = '' -%}
        {%- if current.inventory_management == 'shopify' and current.inventory_quantity > 0 and current.inventory_quantity <= section.settings.low_stock_threshold -%}
          {%- assign cur_stock = section.settings.stock_text | replace: '{qty}', current.inventory_quantity -%}
        {%- endif -%}
        <span class="cp-stock"{% if cur_stock == '' %} hidden{% endif %}>{{ cur_stock }}</span>
      </div>
      {%- if section.settings.tax_text != blank -%}
        <p class="cp-tax">{{ section.settings.tax_text }}</p>
      {%- endif -%}

      {%- comment -%} Review cards {%- endcomment -%}
      {%- assign review_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- assign review_count = review_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if review_count > 0 -%}
        <div class="cp-reviews" id="reviews">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <div class="cp-review" {{ block.shopify_attributes }}>
                <div class="cp-review__top">
                  <span>{{ block.settings.name }}</span>
                  <span class="cp-review__stars">{% for i in (1..block.settings.stars) %}&#9733;{% endfor %}</span>
                </div>
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Select pack (variants shown as cards) {%- endcomment -%}
      {%- if has_variants -%}
        <p class="cp-label">{{ section.settings.pack_label }}</p>
        <div class="cp-packs">
          {%- for v in product.variants -%}
            {%- assign bottles = v.metafields.custom.bottles.value | default: 1 -%}
            {%- assign v_disc = 0 -%}
            {%- if v.compare_at_price > v.price -%}
              {%- assign v_disc = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
            {%- endif -%}
            <div class="cp-pack-wrap">
              <label class="cp-pack{% if v.id == current.id %} is-selected{% endif %}{% unless v.available %} is-soldout{% endunless %}" data-variant="{{ v.id }}">
                <input type="radio" name="cp-pack-{{ section.id }}" value="{{ v.id }}"{% if v.id == current.id %} checked{% endif %}{% unless v.available %} disabled{% endunless %}>
                {%- if v_disc > 0 -%}<span class="cp-pack__off">{{ v_disc }}% off</span>{%- endif -%}
                <span class="cp-pack__check"><svg width="9" height="9" viewBox="0 0 12 12" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5l3 3 5-6"/></svg></span>
                <span class="cp-pack__title">{{ v.title }}</span>
                <span class="cp-pack__sub">{{ v.metafields.custom.pack_note.value }}</span>
                <span class="cp-pack__price">{{ v.price | money_without_trailing_zeros }}</span>
                {%- if v.compare_at_price > v.price -%}<span class="cp-pack__was">{{ v.compare_at_price | money_without_trailing_zeros }}</span>{%- endif -%}
                <span class="cp-pack__per">{{ v.price | divided_by: bottles | money_without_trailing_zeros }} per bottle</span>
              </label>
              {%- if section.settings.best_seller_title != blank and v.title == section.settings.best_seller_title -%}
                <div class="cp-best">Best Seller</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if warning != blank -%}
        <div class="cp-warning">{{ warning | metafield_tag }}</div>
      {%- endif -%}

      {%- comment -%} Purchase form {%- endcomment -%}
      {%- form 'product', product, class: 'cp-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" class="cp-variant-id">
        <input type="hidden" name="return_to" value="/checkout" class="cp-return" disabled>

        <div class="cp-buy">
          <div class="cp-qty">
            <button type="button" class="cp-minus" aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" class="cp-qty-input" aria-label="Quantity">
            <button type="button" class="cp-plus" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" name="add" class="cp-btn cp-btn--add"{% unless current.available %} disabled{% endunless %}>
            {%- if current.available -%}{{ section.settings.add_label }}{%- else -%}{{ section.settings.soldout_label }}{%- endif -%}
          </button>
        </div>

        <div class="cp-row2">
          <button type="button" class="cp-btn cp-btn--buy"{% unless current.available %} disabled{% endunless %}>{{ section.settings.buy_label }}</button>
          {%- if amazon_url != blank -%}
            <a class="cp-amazon" href="{{ amazon_url }}" target="_blank" rel="noopener">
              <span>Available at</span><strong>amazon</strong>
            </a>
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- comment -%} Feature icons {%- endcomment -%}
      {%- assign feature_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'feature' -%}{%- assign feature_count = feature_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if feature_count > 0 -%}
        <div class="cp-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="cp-feature" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.text }}
                {%- endif -%}
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Accordions {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
          {%- assign mf_key = block.settings.metafield_key | strip -%}
          {%- assign mf = nil -%}
          {%- if mf_key != blank -%}
            {%- assign mf = product.metafields.custom[mf_key] -%}
          {%- endif -%}
          {%- if mf != blank or block.settings.use_description or block.settings.content != blank -%}
            <details class="cp-acc" {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.title }}
                <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="transition: transform .2s"><path d="M2 4l4 4 4-4"/></svg>
              </summary>
              <div class="cp-acc__body">
                {%- if mf != blank -%}
                  {{ mf | metafield_tag }}
                {%- elsif block.settings.use_description -%}
                  {{ product.description }}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ================= RIGHT COLUMN ================= {%- endcomment -%}
    <div class="cp-right">
      <div class="cp-gallery">
        {%- if section.settings.wishlist_url != blank -%}
          <a class="cp-heart" href="{{ section.settings.wishlist_url }}" aria-label="Wishlist">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 21s-7-4.6-9.3-9.1C1.1 8.6 3 5 6.4 5c2 0 3.6 1.1 4.6 2.6h2C14 6.1 15.6 5 17.6 5 21 5 22.900 8.600 21.300 11.900 19 16.400 12 21 12 21z"/></svg>
          </a>
        {%- endif -%}

        {%- assign first_media_id = current.featured_media.id | default: product.featured_media.id -%}
        <div class="cp-main">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <div class="cp-slide{% if media.id == first_media_id %} is-active{% endif %}" data-media="{{ media.id }}">
                {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="cp-thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" class="cp-thumb{% if media.id == first_media_id %} is-active{% endif %}" data-media="{{ media.id }}" aria-label="Show image {{ forloop.index }}">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Check delivery {%- endcomment -%}
      <div class="cp-delivery">
        <h3>{{ section.settings.delivery_title }}</h3>
        <div class="cp-delivery__row">
          <input type="text" inputmode="numeric" maxlength="6" class="cp-pin" placeholder="{{ section.settings.delivery_placeholder | escape }}" aria-label="Pincode">
          <button type="button" class="cp-pin-btn">{{ section.settings.delivery_button }}</button>
        </div>
        <p class="cp-delivery__msg" aria-live="polite"></p>
      </div>

      {%- comment -%} Notice banner {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'notice' -%}
          <div class="cp-notice" style="background: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Offers {%- endcomment -%}
      {%- assign offer_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'offer' -%}{%- assign offer_count = offer_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if offer_count > 0 -%}
        <div class="cp-offers">
          <h3>{{ section.settings.offers_title }}</h3>
          <div class="cp-offers__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'offer' -%}
                <div class="cp-offer" {{ block.shopify_attributes }}>
                  <b>{{ block.settings.title }}</b>
                  <span>{{ block.settings.subtitle }}</span>
                  {%- if block.settings.code != blank -%}
                    <button type="button" class="cp-copy" data-code="{{ block.settings.code | escape }}">
                      <span>Code: {{ block.settings.code }}</span>
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 012-2h9"/></svg>
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('CP-{{ section.id }}');
    if (!root) return;

    var V = {
      {%- for v in product.variants -%}
        {%- assign d = 0 -%}
        {%- if v.compare_at_price > v.price -%}
          {%- assign d = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
        {%- endif -%}
        {%- assign st = '' -%}
        {%- if v.inventory_management == 'shopify' and v.inventory_quantity > 0 and v.inventory_quantity <= section.settings.low_stock_threshold -%}
          {%- assign st = section.settings.stock_text | replace: '{qty}', v.inventory_quantity -%}
        {%- endif -%}
        "{{ v.id }}": {
          p: {{ v.price | money_without_trailing_zeros | json }},
          c: {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money_without_trailing_zeros | json }}{% else %}""{% endif %},
          d: {{ d }},
          s: {{ st | json }},
          a: {{ v.available | json }},
          m: {{ v.featured_media.id | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    };

    var idInput = root.querySelector('.cp-variant-id');
    var priceNow = root.querySelector('.cp-price__now');
    var priceWas = root.querySelector('.cp-price__was');
    var priceOff = root.querySelector('.cp-price__off');
    var stock = root.querySelector('.cp-stock');
    var addBtn = root.querySelector('.cp-btn--add');
    var buyBtn = root.querySelector('.cp-btn--buy');
    var form = root.querySelector('form.cp-form');
    var returnInput = root.querySelector('.cp-return');

    /* ----- gallery ----- */
    function showMedia(id) {
      var found = false;
      root.querySelectorAll('.cp-slide').forEach(function (s) {
        var on = s.getAttribute('data-media') === String(id);
        if (on) found = true;
        s.classList.toggle('is-active', on);
      });
      if (!found) return;
      root.querySelectorAll('.cp-thumb').forEach(function (t) {
        t.classList.toggle('is-active', t.getAttribute('data-media') === String(id));
      });
    }
    root.querySelectorAll('.cp-thumb').forEach(function (t) {
      t.addEventListener('click', function () { showMedia(t.getAttribute('data-media')); });
    });

    /* ----- variant (pack) selection ----- */
    function setVariant(id) {
      var v = V[id];
      if (!v) return;
      idInput.value = id;
      priceNow.textContent = v.p;
      priceWas.textContent = v.c;
      priceWas.hidden = !v.c;
      priceOff.textContent = v.d + '% off';
      priceOff.hidden = !v.d;
      stock.textContent = v.s;
      stock.hidden = !v.s;
      addBtn.disabled = !v.a;
      buyBtn.disabled = !v.a;
      addBtn.textContent = v.a ? root.dataset.addLabel : root.dataset.soldOut;
      root.querySelectorAll('.cp-pack').forEach(function (p) {
        p.classList.toggle('is-selected', p.getAttribute('data-variant') === String(id));
      });
      if (v.m) showMedia(v.m);
      try {
        var u = new URL(window.location.href);
        u.searchParams.set('variant', id);
        window.history.replaceState({}, '', u.toString());
      } catch (e) {}
    }
    root.querySelectorAll('.cp-pack input').forEach(function (inp) {
      inp.addEventListener('change', function () { setVariant(inp.value); });
    });

    /* ----- quantity ----- */
    var qty = root.querySelector('.cp-qty-input');
    root.querySelector('.cp-minus').addEventListener('click', function () {
      qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) - 1);
    });
    root.querySelector('.cp-plus').addEventListener('click', function () {
      qty.value = (parseInt(qty.value, 10) || 1) + 1;
    });

    /* ----- buy it now (goes straight to checkout) ----- */
    buyBtn.addEventListener('click', function () {
      returnInput.disabled = false;
      form.submit();
    });

    /* ----- check delivery ----- */
    var pin = root.querySelector('.cp-pin');
    var pinBtn = root.querySelector('.cp-pin-btn');
    var msg = root.querySelector('.cp-delivery__msg');
    function checkPin() {
      var val = pin.value.trim();
      msg.classList.remove('is-error');
      if (!/^[1-9][0-9]{5}$/.test(val)) {
        msg.classList.add('is-error');
        msg.textContent = 'Please enter a valid 6-digit pincode.';
        return;
      }
      var days = parseInt(root.dataset.deliveryDays, 10) || 5;
      var d = new Date();
      d.setDate(d.getDate() + days);
      var text = d.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' });
      msg.textContent = root.dataset.deliveryPrefix + ' ' + text;
    }
    pinBtn.addEventListener('click', checkPin);
    pin.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); checkPin(); } });

    /* ----- copy offer code ----- */
    root.querySelectorAll('.cp-copy').forEach(function (b) {
      b.addEventListener('click', function () {
        var code = b.getAttribute('data-code');
        var label = b.querySelector('span');
        var old = label.textContent;
        function done() { label.textContent = 'Copied!'; setTimeout(function () { label.textContent = old; }, 1500); }
        if (navigator.clipboard) { navigator.clipboard.writeText(code).then(done); }
        else {
          var t = document.createElement('textarea'); t.value = code; document.body.appendChild(t);
          t.select(); try { document.execCommand('copy'); } catch (e) {} document.body.removeChild(t); done();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Custom product",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "primary", "label": "Primary (green)", "default": "#0b8a6f" },
    { "type": "color", "id": "accent", "label": "Accent (orange)", "default": "#f26b3a" },
    { "type": "color", "id": "badge_bg", "label": "Default badge background", "default": "#0b6b57" },
    { "type": "color", "id": "badge_text", "label": "Default badge text", "default": "#ffffff" },

    { "type": "header", "content": "Price area" },
    { "type": "text", "id": "tax_text", "label": "Tax note", "default": "MRP inclusive, of all taxes" },
    { "type": "text", "id": "trusted_text", "label": "Trust text", "default": "Trusted by 1M+ Customers" },
    { "type": "range", "id": "low_stock_threshold", "label": "Show low stock when quantity is at most", "min": 10, "max": 2000, "step": 10, "default": 1000 },
    { "type": "text", "id": "stock_text", "label": "Low stock text ({qty} = quantity)", "default": "Last {qty} bottles left" },

    { "type": "header", "content": "Select pack" },
    { "type": "text", "id": "pack_label", "label": "Heading", "default": "Select Pack" },
    { "type": "text", "id": "best_seller_title", "label": "Best Seller variant title (exact)", "default": "600ml" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "text", "id": "buy_label", "label": "Buy now label", "default": "Buy It Now" },
    { "type": "text", "id": "soldout_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist link (empty = hide heart)" },

    { "type": "header", "content": "Check delivery" },
    { "type": "text", "id": "delivery_title", "label": "Heading", "default": "Check Delivery" },
    { "type": "text", "id": "delivery_placeholder", "label": "Input placeholder", "default": "Enter Pincode" },
    { "type": "text", "id": "delivery_button", "label": "Button label", "default": "Check" },
    { "type": "text", "id": "delivery_prefix", "label": "Result text", "default": "Get it by" },
    { "type": "range", "id": "delivery_days", "label": "Estimated delivery days", "min": 1, "max": 15, "step": 1, "default": 5 },

    { "type": "header", "content": "Offers" },
    { "type": "text", "id": "offers_title", "label": "Heading", "default": "Available Offers" }
  ],
  "blocks": [
    {
      "type": "badge_style",
      "name": "Badge style",
      "settings": [
        { "type": "paragraph", "content": "Badges come from product tags written like: badge:Boosts Immunity. Use this block to style a badge." },
        { "type": "text", "id": "tag", "label": "Badge text (same as in the tag)", "default": "Boosts Immunity" },
        { "type": "color", "id": "bg", "label": "Background", "default": "#0b6b57" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" }
      ]
    },
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Raja Kumar" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "text", "label": "Review", "default": "Great Results, Loved it!" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature icon",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text", "default": "No Added Sugar" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ingredients" },
        { "type": "text", "id": "metafield_key", "label": "Product metafield key (namespace custom)", "info": "Example: ingredients. Leave empty to use the content below." },
        { "type": "checkbox", "id": "use_description", "label": "Use product description", "default": false },
        { "type": "richtext", "id": "content", "label": "Fallback content" }
      ]
    },
    {
      "type": "notice",
      "name": "Notice banner",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "bg", "label": "Background", "default": "#fdf0c4" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh Batch Under Process" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Orders placed between Thursday, 23rd April and Wednesday, 29th April will be shipped 30th April onwards" }
      ]
    },
    {
      "type": "offer",
      "name": "Offer card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Get a EXTRA 10%Off" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "on a Cart value of Rs2199" },
        { "type": "text", "id": "code", "label": "Code", "default": "SUMMER10" }
      ]
    }
  ],
  "presets": [
    { "name": "Custom product" }
  ]
}
{% endschema %}