{{ 'hero-slideshow.css' | asset_url | stylesheet_tag }}

<div class="hero" id="Hero-{{ section.id }}"
     data-autoplay="{{ section.settings.autoplay }}"
     data-speed="{{ section.settings.speed | times: 1000 }}"
     style="--hero-h: {{ section.settings.height }}px; --hero-h-m: {{ section.settings.mobile_height }}px;">

  <div class="hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign loading = 'lazy'
        if forloop.first
          assign loading = 'eager'
        endif
      -%}
      <div class="hero__slide" {{ block.shopify_attributes }}
           style="--text-color: {{ block.settings.text_color }}; --overlay: {{ block.settings.overlay | divide: 100.0 }}; --btn-bg: {{ block.settings.button_bg }}; --btn-text: {{ block.settings.button_text }};">

        <picture>
          {%- if block.settings.mobile_image != blank -%}
            <source media="(max-width: 749px)"
                    srcset="{{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w"
                    sizes="100vw">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2000 | image_tag: loading: loading, widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: block.settings.heading }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </picture>

        <div class="hero__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="hero__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="hero__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="hero__button">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('Hero-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.hero__track');
    var dots = root.querySelectorAll('.hero__dot');
    var n = track.children.length;
    var i = 0, timer;

    function go(k) {
      i = (k + n) % n;
      track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
    }
    function sync() {
      var k = Math.round(track.scrollLeft / track.clientWidth);
      i = k;
      dots.forEach(function (d, j) { d.classList.toggle('is-active', j === k); });
    }
    function start() {
      if (root.dataset.autoplay === 'true' && n > 1) {
        timer = setInterval(function () { go(i + 1); }, +root.dataset.speed);
      }
    }
    function stop() { clearInterval(timer); }

    track.addEventListener('scroll', sync, { passive: true });
    dots.forEach(function (d, j) { d.addEventListener('click', function () { go(j); }); });
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    sync();
    start();
  })();
</script>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    { "type": "range", "id": "height", "label": "Desktop height (px)", "min": 300, "max": 800, "step": 20, "default": 500 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height (px)", "min": 300, "max": 800, "step": 20, "default": 420 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per slide", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image (1920 x 800 px)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (750 x 1000 px)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Handpicked Wellness" },
        { "type": "textarea", "id": "text", "label": "Paragraph" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "color", "id": "button_bg", "label": "Button background", "default": "#0b8a6f" },
        { "type": "color", "id": "button_text", "label": "Button text color", "default": "#ffffff" },
        { "type": "range", "id": "overlay", "label": "Overlay darkness (%)", "min": 0, "max": 70, "step": 5, "default": 20 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}