<style>
  #Hero-{{ section.id }} { position: relative; width: 100%; }
  #Hero-{{ section.id }} .hero__track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  #Hero-{{ section.id }} .hero__track::-webkit-scrollbar { display: none; }

  #Hero-{{ section.id }} .hero__slide {
    position: relative; flex: 0 0 100%; scroll-snap-align: start;
    height: {{ section.settings.height }}px; overflow: hidden;
    background: #cfd8d3; color: #fff;
  }
  #Hero-{{ section.id }} .hero__img,
  #Hero-{{ section.id }} .hero__picture {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    display: block; object-fit: cover; max-width: none;
  }
  #Hero-{{ section.id }} .hero__overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
  }
  #Hero-{{ section.id }} .hero__content {
    position: absolute; z-index: 2; left: 8%; top: 50%;
    transform: translateY(-50%); max-width: 620px;
  }
  #Hero-{{ section.id }} .hero__heading {
    font-family: 'Cormorant SC', Georgia, serif; font-weight: 500;
    font-size: 64px; line-height: 1; letter-spacing: 0; margin: 0 0 24px; color: inherit;
  }
  #Hero-{{ section.id }} .hero__text {
    font-family: 'Archivo', sans-serif; font-weight: 400;
    font-size: 24px; line-height: 1.5; letter-spacing: 0; margin: 0 0 32px; color: inherit;
  }
  #Hero-{{ section.id }} .hero__button {
    display: inline-block; padding: 14px 28px;
    font-family: 'Archivo', sans-serif; font-weight: 500; font-size: 16px;
    text-decoration: none;
  }
  #Hero-{{ section.id }} .hero__dots {
    position: absolute; z-index: 3; bottom: 20px; left: 50%;
    transform: translateX(-50%); display: flex; gap: 8px;
  }
  #Hero-{{ section.id }} .hero__dot {
    width: 8px; height: 8px; padding: 0; border: 0; border-radius: 999px;
    background: rgba(255,255,255,.55); cursor: pointer; transition: width .3s;
  }
  #Hero-{{ section.id }} .hero__dot.is-active { width: 36px; background: #fff; }

  @media (max-width: 749px) {
    #Hero-{{ section.id }} .hero__slide { height: {{ section.settings.mobile_height }}px; }
    #Hero-{{ section.id }} .hero__content { top: 24px; transform: none; left: 5%; right: 5%; max-width: none; }
    #Hero-{{ section.id }} .hero__heading { font-size: 32px; margin-bottom: 12px; }
    #Hero-{{ section.id }} .hero__text { font-size: 16px; margin-bottom: 20px; }
    #Hero-{{ section.id }} .hero__button { padding: 12px 24px; font-size: 15px; }
  }
</style>

<div class="hero" id="Hero-{{ section.id }}"
     data-autoplay="{{ section.settings.autoplay }}"
     data-speed="{{ section.settings.speed | times: 1000 }}">

  <div class="hero__track">
    {%- for block in section.blocks -%}
      <div class="hero__slide" {{ block.shopify_attributes }} style="color: {{ block.settings.text_color }};">

        {%- if block.settings.image != blank -%}
          <picture class="hero__picture">
            {%- if block.settings.mobile_image != blank -%}
              <source media="(max-width: 749px)"
                      srcset="{{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                              {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w"
                      sizes="100vw">
            {%- endif -%}
            <img class="hero__img"
                 src="{{ block.settings.image | image_url: width: 1920 }}"
                 srcset="{{ block.settings.image | image_url: width: 750 }} 750w,
                         {{ block.settings.image | image_url: width: 1100 }} 1100w,
                         {{ block.settings.image | image_url: width: 1500 }} 1500w,
                         {{ block.settings.image | image_url: width: 1920 }} 1920w"
                 sizes="100vw"
                 alt="{{ block.settings.heading | escape }}"
                 loading="eager">
          </picture>
        {%- endif -%}

        <div class="hero__overlay"
             style="background: rgba(0,0,0,{{ block.settings.overlay | divide: 100.0 }});"></div>

        <div class="hero__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="hero__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.paragraph != blank -%}
            <p class="hero__text">{{ block.settings.paragraph | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="hero__button"
               style="background: {{ block.settings.button_bg }}; color: {{ block.settings.button_text }};">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('Hero-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.hero__track');
    var dots = root.querySelectorAll('.hero__dot');
    var n = track.children.length;
    var i = 0, timer;

    function go(k) {
      i = (k + n) % n;
      track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
    }
    function sync() {
      var k = Math.round(track.scrollLeft / track.clientWidth);
      i = k;
      dots.forEach(function (d, j) { d.classList.toggle('is-active', j === k); });
    }
    function start() {
      if (root.dataset.autoplay === 'true' && n > 1) {
        timer = setInterval(function () { go(i + 1); }, +root.dataset.speed);
      }
    }
    function stop() { clearInterval(timer); }

    track.addEventListener('scroll', sync, { passive: true });
    dots.forEach(function (d, j) { d.addEventListener('click', function () { go(j); }); });
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    sync();
    start();
  })();
</script>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    { "type": "range", "id": "height", "label": "Desktop height (px)", "min": 300, "max": 800, "step": 20, "default": 500 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height (px)", "min": 300, "max": 800, "step": 20, "default": 420 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per slide", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image (1920 x 800 px)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (750 x 1000 px)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Handpicked Wellness" },
        { "type": "textarea", "id": "paragraph", "label": "Paragraph", "default": "Discover authentic Himalayan products, handpicked for your wellbeing." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "color", "id": "button_bg", "label": "Button background", "default": "#0b8a6f" },
        { "type": "color", "id": "button_text", "label": "Button text color", "default": "#ffffff" },
        { "type": "range", "id": "overlay", "label": "Overlay darkness (%)", "min": 0, "max": 70, "step": 5, "default": 20 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Hero slideshow", "blocks": [{ "type": "slide" }] }
  ]
}
{% endschema %}