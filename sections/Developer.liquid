<section class="dev-profile-wrap section-{{ section.id }}">
  <a class="dev-profile" href="{{ section.settings.link | default: '#' }}">
    <span class="dev-profile__avatar">
      {%- if section.settings.avatar != blank -%}
        {{ section.settings.avatar | image_url: width: 80 | image_tag: width: 36, height: 36, loading: 'lazy', alt: section.settings.name }}
      {%- else -%}
        {{ section.settings.name | strip | slice: 0 | upcase }}
      {%- endif -%}
    </span>

    <span class="dev-profile__text">
      {%- if section.settings.name != blank -%}
        <span class="dev-profile__name">{{ section.settings.name }}</span>
      {%- endif -%}
      {%- if section.settings.designation != blank -%}
        <span class="dev-profile__designation">{{ section.settings.designation }}</span>
      {%- endif -%}
    </span>
  </a>
</section>

{% style %}
    .section-{{ section.id }} {
    width: fit-content;
    padding: 8px 20px;
    {%- case section.settings.alignment -%}
      {%- when 'flex-start' -%}
        margin-right: auto;
      {%- when 'center' -%}
        margin-left: auto;
        margin-right: auto;
      {%- when 'flex-end' -%}
        margin-left: auto;
    {%- endcase -%}
  }
  .section-{{ section.id }} .dev-profile {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 16px 5px 5px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background-color: {{ section.settings.pill_color }};
    color: {{ section.settings.text_color }};
    text-decoration: none;
    line-height: 1.2;
  }
  .section-{{ section.id }} .dev-profile__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.pill_color }};
    font-weight: 600;
    font-size: 16px;
    flex-shrink: 0;
  }
  .section-{{ section.id }} .dev-profile__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section-{{ section.id }} .dev-profile__text {
    display: flex;
    flex-direction: column;
  }
  .section-{{ section.id }} .dev-profile__name {
    font-size: 14px;
    font-weight: 600;
  }
  .section-{{ section.id }} .dev-profile__designation {
    font-size: 12px;
    opacity: 0.75;
  }
  @media (max-width: 749px) {
    .section-{{ section.id }} { padding: 6px 12px; }
    .section-{{ section.id }} .dev-profile__name { font-size: 13px; }
    .section-{{ section.id }} .dev-profile__designation { font-size: 11px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Developer",
  "tag": "section",
  "class": "developer",
  "settings": [
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Satya Prakash Yadav"
    },
    {
      "type": "text",
      "id": "designation",
      "label": "Designation",
      "default": "Web Developer Associate"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Profile photo (optional)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Position",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-end"
    },
    {
      "type": "color",
      "id": "pill_color",
      "label": "Button background",
      "default": "#f4f1ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Developer"
    }
  ]
}
{% endschema %}