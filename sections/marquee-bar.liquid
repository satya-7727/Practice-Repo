<style>
  .marquee {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    padding: 14px 0;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll {{ section.settings.speed }}s linear infinite;
  }
  .marquee__group { display: flex; align-items: center; flex-shrink: 0; }
  .marquee__item {
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .marquee__sep { margin: 0 28px; font-size: 14px; }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }
  @media (max-width: 749px) {
    .marquee__sep { margin: 0 18px; }
  }
</style>

<div class="marquee">
  <div class="marquee__track">
    {%- for copy in (1..2) -%}
      <div class="marquee__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
        {%- for rep in (1..3) -%}
          {%- for block in section.blocks -%}
            <span class="marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            <span class="marquee__sep">&#9670;</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background color", "default": "#a8522b" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "Scroll duration (seconds, higher = slower)", "min": 10, "max": 60, "step": 5, "default": 30 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Kashmir's Saffron" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Scrolling text bar",
      "blocks": [
        { "type": "item", "settings": { "text": "Kashmir's Saffron" } },
        { "type": "item", "settings": { "text": "Himalaya's Shilajit" } },
        { "type": "item", "settings": { "text": "Ladakh's Seabuckthorn" } }
      ]
    }
  ]
}
{% endschema %}