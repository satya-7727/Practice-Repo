
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'MainProductForm-' | append: section.id
  assign reviews = product.metafields.custom.reviews.value
  assign ingredients = product.metafields.custom.ingredients.value
  assign additional_info = product.metafields.custom.additional_information.value
%}

<section id="MainProduct-{{ section.id }}" class="main-product-section">

  <div class="main-product-container">

    <!-- LEFT COLUMN: PRODUCT INFORMATION -->
    <div class="main-product-info">

<!-- PRODUCT BADGES FROM TAGS -->

{% if product.tags.size > 0 %}
  <div class="product-badges">

    {% assign badge_index = 0 %}

    {% for tag in product.tags %}

      {% assign badge_name = tag | strip %}
      {% assign color_index = badge_index | modulo: 5 %}

      <span class="product-badge"
        {% case color_index %}
          {% when 0 %}
            style="background: #dbeafe; color: #1d4ed8;"
          {% when 1 %}
            style="background: #fee2e2; color: #dc2626;"
          {% when 2 %}
            style="background: #fef3c7; color: #92400e;"
          {% when 3 %}
            style="background: #f3e8ff; color: #7e22ce;"
          {% when 4 %}
            style="background: #dcfce7; color: #166534;"
        {% endcase %}
      >
        {{ badge_name | escape }}
      </span>

      {% assign badge_index = badge_index | plus: 1 %}

    {% endfor %}

  </div>
{% endif %}
  </div>


      <!-- PRODUCT TITLE -->
      <h1 class="product-title">
        {{ product.title }}
      </h1>

      <!-- RATING -->
      {% if section.settings.show_rating %}
        <div class="product-rating">

          <div class="rating-stars">
            ★★★★★
          </div>

          {% if section.settings.rating_text != blank %}
            <span class="rating-text">
              {{ section.settings.rating_text }}
            </span>
          {% endif %}

          {% if section.settings.trust_text != blank %}
            <span class="trust-text">
              {{ section.settings.trust_text }}
            </span>
          {% endif %}

        </div>
      {% endif %}

      <!-- VENDOR -->
      {% if section.settings.show_vendor %}
        <div class="product-vendor">
          Vendor:
          <a href="{{ product.vendor | url_for_vendor }}">
            {{ product.vendor }}
          </a>
        </div>
      {% endif %}

      <div class="product-divider"></div>

      <!-- PRICE -->
      <div class="product-price-container">

        <span
          class="product-price"
          id="ProductPrice-{{ section.id }}"
        >
          {{ current_variant.price | money }}
        </span>

        {% if current_variant.compare_at_price > current_variant.price %}
          <span
            class="product-compare-price"
            id="ProductComparePrice-{{ section.id }}"
          >
            {{ current_variant.compare_at_price | money }}
          </span>

          {% assign discount = current_variant.compare_at_price
            | minus: current_variant.price
            | times: 100.0
            | divided_by: current_variant.compare_at_price
          %}

          <span class="product-discount">
            {{ discount | round }}% OFF
          </span>
        {% endif %}

        {% if section.settings.show_stock_message %}
          <span class="product-stock-message">
            {{ section.settings.stock_message }}
          </span>
        {% endif %}

      </div>

      {% if section.settings.show_tax_text %}
        <p class="product-tax-text">
          {{ section.settings.tax_text }}
        </p>
      {% endif %}

      <!-- REVIEW CARDS FROM METAFIELD -->
      {% if reviews != blank and section.settings.show_reviews %}
        <div class="product-reviews">

          {% for review in reviews %}
            <div class="review-card">

              <div class="review-card-header">

                <span class="review-name">
                  {{ review.name }}
                </span>

                <span class="review-stars">
                  {% for i in (1..5) %}
                    {% if i <= review.stars %}
                      ★
                    {% else %}
                      ☆
                    {% endif %}
                  {% endfor %}
                </span>

              </div>

              <p class="review-content">
                {{ review.text }}
              </p>

            </div>
          {% endfor %}

        </div>
      {% endif %}

      <!-- PRODUCT FORM -->
      {% form 'product', product, id: product_form_id, class: 'main-product-form' %}

        <!-- VARIANT / PACK SELECTOR -->
        {% if product.variants.size > 1 %}
          <div class="product-variant-section">

            <label class="variant-heading">
              {{ section.settings.variant_heading }}
            </label>

            <div class="variant-cards">

              {% for variant in product.variants %}

                {% assign variant_discount = 0 %}

                {% if variant.compare_at_price > variant.price %}
                  {% assign variant_discount = variant.compare_at_price
                    | minus: variant.price
                    | times: 100.0
                    | divided_by: variant.compare_at_price
                    | round
                  %}
                {% endif %}

                <label
                  class="variant-card
                    {% if variant.id == current_variant.id %}
                      selected
                    {% endif %}
                    {% unless variant.available %}
                      sold-out
                    {% endunless %}"
                  data-variant-card
                >

                  <input
                    type="radio"
                    name="variant-selection-{{ section.id }}"
                    value="{{ variant.id }}"
                    {% if variant.id == current_variant.id %}
                      checked
                    {% endif %}
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                    data-variant-input
                  >

                  {% if variant_discount > 0 %}
                    <span class="variant-discount">
                      {{ variant_discount }}% off
                    </span>
                  {% endif %}

                  {% if forloop.index == 2 %}
                    <span class="variant-best-seller">
                      Best Seller
                    </span>
                  {% endif %}

                  <span class="variant-title">
                    {{ variant.title }}
                  </span>

                  <span class="variant-subtitle">
                    {{ variant.title }}
                  </span>

                  <span class="variant-price">
                    {{ variant.price | money }}
                  </span>

                  {% if variant.compare_at_price > variant.price %}
                    <span class="variant-compare-price">
                      {{ variant.compare_at_price | money }}
                    </span>
                  {% endif %}

                  {% if section.settings.show_price_per_unit %}
                    <span class="variant-unit-price">
                      {{ variant.price | money }}
                      {% if variant.title contains '300' %}
                        per bottle
                      {% endif %}
                    </span>
                  {% endif %}

                </label>

              {% endfor %}

            </div>

          </div>

        {% else %}

          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
          >

        {% endif %}

        <!-- VARIANT ID FOR SHOPIFY CART -->
        <input
          type="hidden"
          name="id"
          value="{{ current_variant.id }}"
          id="SelectedVariant-{{ section.id }}"
        >

        <!-- NOTICE -->
        {% if product.metafields.custom.notice!=blank %}
          <div class="product-notice">
            {{ product.metafields.custom.notice.value }}
          </div>
        {% endif %}

        <!-- QUANTITY AND ADD TO CART -->
        <div class="product-actions">

          <div class="quantity-selector">

            <button
              type="button"
              class="quantity-button"
              data-quantity-minus
              aria-label="Decrease quantity"
            >
              −
            </button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              class="quantity-input"
              id="Quantity-{{ section.id }}"
            >

            <button
              type="button"
              class="quantity-button"
              data-quantity-plus
              aria-label="Increase quantity"
            >
              +
            </button>

          </div>

          <button
            type="submit"
            name="add"
            class="add-to-cart-button"
            id="AddToCart-{{ section.id }}"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {% if current_variant.available %}
              {{ section.settings.add_to_cart_text }}
            {% else %}
              Sold Out
            {% endif %}
          </button>

        </div>

        <!-- BUY NOW -->
        {% if section.settings.show_buy_now %}
          <div class="buy-now-container">
            {{ form | payment_button }}
          </div>
        {% endif %}

      {% endform %}

      <!-- FEATURES -->
      {% if section.settings.show_features %}
        <div class="product-features">

          {% for block in section.blocks %}
            {% if block.type == 'feature' %}

              <div
                class="product-feature"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.icon != blank %}
                  <div class="feature-icon">
                    {{ block.settings.icon }}
                  </div>
                {% endif %}

                <div class="feature-text">
                  {{ block.settings.text }}
                </div>

              </div>

            {% endif %}
          {% endfor %}

        </div>
      {% endif %}

      <!-- INGREDIENTS ACCORDION -->
      {% if ingredients != blank %}
        <details class="product-accordion">

          <summary>
            {{ section.settings.ingredients_heading }}
            <span class="accordion-icon">⌄</span>
          </summary>

          <div class="accordion-content">
            {{ ingredients }}
          </div>

        </details>
      {% endif %}

      <!-- ADDITIONAL INFORMATION ACCORDION -->
      {% if additional_info != blank %}
        <details class="product-accordion">

          <summary>
            {{ section.settings.additional_info_heading }}
            <span class="accordion-icon">⌄</span>
          </summary>

          <div class="accordion-content">
            {{ additional_info }}
          </div>

        </details>
      {% endif %}

      <!-- CUSTOM ACCORDION BLOCKS -->
      {% for block in section.blocks %}

        {% if block.type == 'accordion' %}

          <details
            class="product-accordion"
            {{ block.shopify_attributes }}
          >

            <summary>
              {{ block.settings.heading }}
              <span class="accordion-icon">⌄</span>
            </summary>

            <div class="accordion-content">
              {{ block.settings.content }}
            </div>

          </details>

        {% endif %}

      {% endfor %}

    </div>

    <!-- RIGHT COLUMN: PRODUCT MEDIA AND EXTRA CONTENT -->
    <div class="main-product-media">

      <!-- WISHLIST BUTTON -->
      {% if section.settings.show_wishlist %}
        <button
          type="button"
          class="wishlist-button"
          aria-label="Add to wishlist"
          data-wishlist
        >
          ♡
        </button>
      {% endif %}

      <!-- PRODUCT GALLERY -->
      <div class="product-gallery">

        <div class="product-main-image">

          {% if current_variant.featured_media != blank %}
            {% assign featured_media = current_variant.featured_media %}
          {% else %}
            {% assign featured_media = product.featured_media %}
          {% endif %}

          {% if featured_media != blank %}

            <img
              src="{{ featured_media | image_url: width: 1200 }}"
              alt="{{ featured_media.alt | escape }}"
              width="{{ featured_media.width }}"
              height="{{ featured_media.height }}"
              loading="eager"
              id="MainProductImage-{{ section.id }}"
            >

          {% else %}

            {{ 'product-1' | placeholder_svg_tag: 'product-placeholder' }}

          {% endif %}

        </div>

        <!-- THUMBNAILS -->
        {% if product.media.size > 1 %}

          <div class="product-thumbnails">

            {% for media in product.media %}

              {% if media.media_type == 'image' %}

                <button
                  type="button"
                  class="product-thumbnail
                    {% if media.id == featured_media.id %}
                      active
                    {% endif %}"
                  data-thumbnail
                  data-image="{{ media | image_url: width: 1200 }}"
                  data-media-id="{{ media.id }}"
                  aria-label="View product image {{ forloop.index }}"
                >

                  <img
                    src="{{ media | image_url: width: 150 }}"
                    alt="{{ media.alt | escape }}"
                    width="100"
                    height="100"
                    loading="lazy"
                  >

                </button>

              {% endif %}

            {% endfor %}

          </div>

        {% endif %}

      </div>

      <!-- DELIVERY CHECKER -->
      {% if section.settings.show_delivery_checker %}

        <div class="delivery-checker">

          <h3>
            {{ section.settings.delivery_heading }}
          </h3>

          <div class="delivery-form">

            <input
              type="text"
              maxlength="6"
              placeholder="Enter Pincode"
              id="Pincode-{{ section.id }}"
            >

            <button
              type="button"
              id="CheckPincode-{{ section.id }}"
            >
              Check
            </button>

          </div>

          <div
            class="delivery-result"
            id="DeliveryResult-{{ section.id }}"
          ></div>

          {% if section.settings.delivery_text != blank %}
            <p class="delivery-info">
              {{ section.settings.delivery_text }}
            </p>
          {% endif %}

        </div>

      {% endif %}

      <!-- NOTICE BANNER BLOCKS -->
      {% for block in section.blocks %}

        {% if block.type == 'notice' %}

          <div
            class="product-notice-banner"
            {{ block.shopify_attributes }}
          >

            <h3>
              {{ block.settings.heading }}
            </h3>

            <div>
              {{ block.settings.content }}
            </div>

          </div>

        {% endif %}

      {% endfor %}

      <!-- OFFERS -->
      {% if section.settings.show_offers %}

        <div class="product-offers">

          <h3>
            {{ section.settings.offers_heading }}
          </h3>

          <div class="offer-list">

            {% for block in section.blocks %}

              {% if block.type == 'offer' %}

                <div
                  class="offer-card"
                  {{ block.shopify_attributes }}
                >

                  <div class="offer-content">
                    {{ block.settings.content }}
                  </div>

                  {% if block.settings.code != blank %}

                    <div class="offer-code-container">

                      <span class="offer-code">
                        {{ block.settings.code }}
                      </span>

                      <button
                        type="button"
                        class="copy-offer-code"
                        data-copy-code="{{ block.settings.code }}"
                      >
                        Copy
                      </button>

                    </div>

                  {% endif %}

                </div>

              {% endif %}

            {% endfor %}

          </div>

        </div>

      {% endif %}

    </div>

  </div>

</section>

<style>

  #MainProduct-{{ section.id }} {
    width: 100%;
  }

  #MainProduct-{{ section.id }} .main-product-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 30px;
  }

  #MainProduct-{{ section.id }} .main-product-info {
    min-width: 0;
  }

  #MainProduct-{{ section.id }} .main-product-media {
    min-width: 0;
    position: relative;
  }

  /* BADGES */

  #MainProduct-{{ section.id }} .product-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 15px;
  }

  #MainProduct-{{ section.id }} .product-badge {
    display: inline-block;
    background: #006b57;
    color: #ffffff;
    padding: 5px 10px;
    font-size: 11px;
    border-radius: 4px;
  }

  /* TITLE */

  #MainProduct-{{ section.id }} .product-title {
    font-size: 28px;
    line-height: 1.4;
    margin: 0 0 12px;
    font-weight: 500;
  }

  /* RATING */

  #MainProduct-{{ section.id }} .product-rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 12px;
    margin-bottom: 12px;
  }

  #MainProduct-{{ section.id }} .rating-stars {
    color: #f5a623;
    font-size: 17px;
  }

  #MainProduct-{{ section.id }} .rating-text {
    color: #008c72;
    text-decoration: underline;
  }

  #MainProduct-{{ section.id }} .trust-text {
    color: #555;
  }

  /* VENDOR */

  #MainProduct-{{ section.id }} .product-vendor {
    font-size: 12px;
    margin-bottom: 20px;
  }

  #MainProduct-{{ section.id }} .product-vendor a {
    color: inherit;
  }

  #MainProduct-{{ section.id }} .product-divider {
    border-top: 1px solid #eeeeee;
    margin: 20px 0;
  }

  /* PRICE */

  #MainProduct-{{ section.id }} .product-price-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  #MainProduct-{{ section.id }} .product-price {
    font-size: 26px;
    font-weight: 600;
  }

  #MainProduct-{{ section.id }} .product-compare-price {
    font-size: 14px;
    color: #888;
    text-decoration: line-through;
  }

  #MainProduct-{{ section.id }} .product-discount {
    background: #ffdfd6;
    color: #c33c16;
    font-size: 12px;
    padding: 4px 7px;
    border-radius: 3px;
  }

  #MainProduct-{{ section.id }} .product-stock-message {
    color: #d83218;
    font-size: 12px;
  }

  #MainProduct-{{ section.id }} .product-tax-text {
    font-size: 11px;
    color: #888;
    margin-top: 5px;
  }

  /* REVIEWS */

  #MainProduct-{{ section.id }} .product-reviews {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    margin: 20px 0;
    scrollbar-width: thin;
  }

  #MainProduct-{{ section.id }} .review-card {
    min-width: 140px;
    max-width: 180px;
    flex: 1;
    padding: 12px;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
  }

  #MainProduct-{{ section.id }} .review-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
  }

  #MainProduct-{{ section.id }} .review-name {
    font-size: 12px;
    font-weight: 500;
  }

  #MainProduct-{{ section.id }} .review-stars {
    color: #f5a623;
    font-size: 11px;
    white-space: nowrap;
  }

  #MainProduct-{{ section.id }} .review-content {
    font-size: 12px;
    margin: 8px 0 0;
    line-height: 1.4;
  }

  /* VARIANTS */

  #MainProduct-{{ section.id }} .product-variant-section {
    margin: 25px 0;
  }

  #MainProduct-{{ section.id }} .variant-heading {
    display: block;
    margin-bottom: 12px;
    font-size: 14px;
  }

  #MainProduct-{{ section.id }} .variant-cards {
    display: flex;
    gap: 10px;
    overflow-x: auto;
  }

  #MainProduct-{{ section.id }} .variant-card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 0 0 110px;
    padding: 12px 8px;
    border: 1px solid #e5e5e5;
    border-radius: 7px;
    cursor: pointer;
    gap: 5px;
    background: #ffffff;
  }

  #MainProduct-{{ section.id }} .variant-card.selected {
    border: 1px solid #008c72;
    background: #f3fffc;
  }

  #MainProduct-{{ section.id }} .variant-card input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  #MainProduct-{{ section.id }} .variant-discount {
    position: absolute;
    top: 0;
    left: 0;
    background: #e3f5f2;
    color: #008c72;
    padding: 3px 5px;
    font-size: 10px;
  }

  #MainProduct-{{ section.id }} .variant-best-seller {
    position: absolute;
    bottom: -18px;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 10px;
    color: #f36b21;
  }

  #MainProduct-{{ section.id }} .variant-title {
    margin-top: 15px;
    font-size: 13px;
  }

  #MainProduct-{{ section.id }} .variant-subtitle {
    font-size: 11px;
    color: #888;
  }

  #MainProduct-{{ section.id }} .variant-price {
    font-size: 14px;
    font-weight: 600;
    margin-top: 5px;
  }

  #MainProduct-{{ section.id }} .variant-compare-price {
    font-size: 11px;
    color: #888;
    text-decoration: line-through;
  }

  #MainProduct-{{ section.id }} .variant-unit-price {
    font-size: 10px;
    color: #777;
  }

  #MainProduct-{{ section.id }} .variant-card.sold-out {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* NOTICE */

  #MainProduct-{{ section.id }} .product-notice {
    background: #fff0b8;
    padding: 14px;
    font-size: 12px;
    line-height: 1.6;
    border-radius: 8px;
    margin: 20px 0;
  }

  /* QUANTITY AND CART */

  #MainProduct-{{ section.id }} .product-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }

  #MainProduct-{{ section.id }} .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    width: 100px;
    flex-shrink: 0;
  }

  #MainProduct-{{ section.id }} .quantity-button {
    width: 32px;
    height: 40px;
    border: 0;
    background: transparent;
    font-size: 20px;
    cursor: pointer;
  }

  #MainProduct-{{ section.id }} .quantity-input {
    width: 36px;
    text-align: center;
    border: 0;
    background: transparent;
    -moz-appearance: textfield;
  }

  #MainProduct-{{ section.id }} .quantity-input::-webkit-inner-spin-button,
  #MainProduct-{{ section.id }} .quantity-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  #MainProduct-{{ section.id }} .add-to-cart-button {
    flex: 1;
    border: 1px solid #008c72;
    background: #ffffff;
    color: #008c72;
    border-radius: 6px;
    height: 42px;
    font-weight: 600;
    cursor: pointer;
  }

  #MainProduct-{{ section.id }} .add-to-cart-button:hover {
    background: #008c72;
    color: #ffffff;
  }

  #MainProduct-{{ section.id }} .add-to-cart-button:disabled {
    background: #eeeeee;
    color: #777;
    cursor: not-allowed;
  }

  /* BUY NOW */

  #MainProduct-{{ section.id }} .buy-now-container {
    margin-top: 10px;
  }

  #MainProduct-{{ section.id }} .buy-now-container .shopify-payment-button {
    width: 100%;
  }

  #MainProduct-{{ section.id }} .buy-now-container .shopify-payment-button__button {
    border-radius: 6px !important;
    min-height: 42px;
  }

  /* FEATURES */

  #MainProduct-{{ section.id }} .product-features {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: 25px 0;
  }

  #MainProduct-{{ section.id }} .product-feature {
    flex: 1;
    text-align: center;
    font-size: 12px;
  }

  #MainProduct-{{ section.id }} .feature-icon {
    font-size: 24px;
    color: #008c72;
    margin-bottom: 5px;
  }

  /* ACCORDIONS */

  #MainProduct-{{ section.id }} .product-accordion {
    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
    margin-top: -1px;
  }

  #MainProduct-{{ section.id }} .product-accordion summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
  }

  #MainProduct-{{ section.id }} .product-accordion summary::-webkit-details-marker {
    display: none;
  }

  #MainProduct-{{ section.id }} .accordion-icon {
    font-size: 20px;
  }

  #MainProduct-{{ section.id }} .product-accordion[open] .accordion-icon {
    transform: rotate(180deg);
  }

  #MainProduct-{{ section.id }} .accordion-content {
    padding: 0 0 15px;
    font-size: 13px;
    line-height: 1.7;
  }

  /* GALLERY */

  #MainProduct-{{ section.id }} .product-gallery {
    position: relative;
  }

  #MainProduct-{{ section.id }} .product-main-image {
    background: #f5f5f5;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  #MainProduct-{{ section.id }} .product-main-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #MainProduct-{{ section.id }} .product-placeholder {
    width: 100%;
    height: 100%;
