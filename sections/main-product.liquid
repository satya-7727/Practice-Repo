<script>
(function() {

  const section = document.getElementById('MainProduct-{{ section.id }}');

  if (!section) return;

  /* VARIANT SELECTION */

  const variantInputs = section.querySelectorAll('[data-variant-input]');
  const variantCards = section.querySelectorAll('[data-variant-card]');
  const selectedVariantInput = section.querySelector('#SelectedVariant-{{ section.id }}');

  const priceElement = section.querySelector('#ProductPrice-{{ section.id }}');
  const comparePriceElement = section.querySelector('#ProductComparePrice-{{ section.id }}');
  const addToCartButton = section.querySelector('#AddToCart-{{ section.id }}');

  const variants = {{ product.variants | json }};

  const moneyFormat = {{ shop.money_format | json }};

  function formatMoney(cents) {

    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, moneyFormat);
    }

    return (cents / 100).toLocaleString(undefined, {
      style: 'currency',
      currency: '{{ cart.currency.iso_code }}'
    });

  }

  variantInputs.forEach(function(input) {

    input.addEventListener('change', function() {

      const selectedVariant = variants.find(function(variant) {
        return variant.id == input.value;
      });

      if (!selectedVariant) return;

      if (selectedVariantInput) {
        selectedVariantInput.value = selectedVariant.id;
      }

      if (priceElement) {
        priceElement.innerHTML = formatMoney(selectedVariant.price);
      }

      if (comparePriceElement) {

        if (selectedVariant.compare_at_price > selectedVariant.price) {
          comparePriceElement.innerHTML = formatMoney(selectedVariant.compare_at_price);
          comparePriceElement.style.display = '';
        } else {
          comparePriceElement.style.display = 'none';
        }

      }

      if (addToCartButton) {

        addToCartButton.disabled = !selectedVariant.available;

        addToCartButton.textContent = selectedVariant.available
          ? '{{ section.settings.add_to_cart_text | escape }}'
          : 'Sold Out';

      }

      variantCards.forEach(function(card) {
        card.classList.remove('selected');
      });

      input.closest('[data-variant-card]').classList.add('selected');

      /* CHANGE IMAGE WHEN VARIANT HAS FEATURED IMAGE */

      if (selectedVariant.featured_image && selectedVariant.featured_image.src) {

        const mainImage = section.querySelector('#MainProductImage-{{ section.id }}');

        if (mainImage) {
          mainImage.src = selectedVariant.featured_image.src;
        }

      }

    });

  });

  /* QUANTITY */

  const quantityInput = section.querySelector('#Quantity-{{ section.id }}');
  const quantityMinus = section.querySelector('[data-quantity-minus]');
  const quantityPlus = section.querySelector('[data-quantity-plus]');

  if (quantityMinus && quantityInput) {

    quantityMinus.addEventListener('click', function() {

      const currentQuantity = parseInt(quantityInput.value) || 1;

      if (currentQuantity > 1) {
        quantityInput.value = currentQuantity - 1;
      }

    });

  }

  if (quantityPlus && quantityInput) {

    quantityPlus.addEventListener('click', function() {

      const currentQuantity = parseInt(quantityInput.value) || 1;

      quantityInput.value = currentQuantity + 1;

    });

  }

  /* IMAGE THUMBNAILS */

  const thumbnails = section.querySelectorAll('[data-thumbnail]');

  thumbnails.forEach(function(thumbnail) {

    thumbnail.addEventListener('click', function() {

      const mainImage = section.querySelector('#MainProductImage-{{ section.id }}');

      if (!mainImage) return;

      mainImage.src = thumbnail.dataset.image;

      thumbnails.forEach(function(item) {
        item.classList.remove('active');
      });

      thumbnail.classList.add('active');

    });

  });

  /* WISHLIST VISUAL TOGGLE */

  const wishlistButton = section.querySelector('[data-wishlist]');

  if (wishlistButton) {

    wishlistButton.addEventListener('click', function() {

      const isActive = wishlistButton.classList.toggle('active');

      wishlistButton.textContent = isActive ? '♥' : '♡';

      wishlistButton.style.color = isActive ? '#e53935' : '';

    });

  }

  /* PINCODE CHECKER - FRONTEND VALIDATION */

  const pincodeInput = section.querySelector('#Pincode-{{ section.id }}');
  const pincodeButton = section.querySelector('#CheckPincode-{{ section.id }}');
  const deliveryResult = section.querySelector('#DeliveryResult-{{ section.id }}');

  if (pincodeButton && pincodeInput && deliveryResult) {

    pincodeButton.addEventListener('click', function() {

      const pincode = pincodeInput.value.trim();

      if (!/^[0-9]{6}$/.test(pincode)) {

        deliveryResult.textContent = 'Please enter a valid 6-digit pincode.';
        deliveryResult.style.color = '#d83218';

        return;

      }

      deliveryResult.textContent = 'Pincode entered successfully. Delivery availability needs to be connected to your delivery service.';
      deliveryResult.style.color = '#008c72';

    });

  }

  /* COPY OFFER CODE */

  const copyButtons = section.querySelectorAll('[data-copy-code]');

  copyButtons.forEach(function(button) {

    button.addEventListener('click', function() {

      const code = button.dataset.copyCode;

      if (navigator.clipboard) {

        navigator.clipboard.writeText(code).then(function() {
          button.textContent = 'Copied!';
        });

      }

    });

  });

})();
</script>

